                        </a>

                    </div>

                </div>



                <!-- QUICK LINKS -->

                <div class="footer-column">

                    <h3>Quick Links</h3>

                    <a href="#">About Us</a>

                    <a href="#">Sectors</a>

                    <a href="#">Sustainability</a>

                    <a href="#">Downloads</a>

                    <a href="#">News &amp; Events</a>

                </div>



                <!-- QUICK LINKS 2 -->

                <div class="footer-column">

                    <h3>Quick Links</h3>

                    <a href="#">FAQs</a>

                    <a href="#">Glossary</a>

                </div>



                <!-- CONTACT -->

                <div class="footer-column">

                    <h3>Contact Us</h3>

                    <p>
                        <i class="fa-solid fa-phone"></i>
                        +971 24167042
                    </p>

                    <p>
                        <i class="fa-solid fa-envelope"></i>
                        info@desertboard.ae
                    </p>

                </div>

            </div>



            <!-- COPYRIGHT -->

            <div class="copyright">

                © 2026 DesertBoard. All rights reserved.

            </div>

        </div>

    </footer>


</body>

</html>