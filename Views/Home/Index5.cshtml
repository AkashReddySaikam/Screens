            </div>

        </div>

        <!-- FOOTER BOTTOM -->
        <div class="footer-bottom">

            <!-- SOCIAL MEDIA -->
            <div class="socials">
                <a href="https://www.facebook.com/"
                   aria-label="Facebook" target="_blank"
                   rel="noopener noreferrer">f</a>

                <a href="https://www.instagram.com/"
