                <a href="https://www.linkedin.com/"
                   aria-label="LinkedIn" target="_blank"
                   rel="noopener noreferrer">in</a>
            </div>

            <!-- PHONE, EMAIL AND ADDRESS -->
            <div class="footer-contact">

                <a href="tel:+9711234565" class="contact-item">
