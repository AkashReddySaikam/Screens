
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ECC Fitout & Construction</title>

    <style>
        :root {
            --green: #303a35;
            --footer: #f8f7f5;
            --text: #252b27;
            --muted: #777872;
            --line: #e8e6e2;
            --gold: #b79b65;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            color: var(--text);
            background: #fff;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        /* =========================
           HEADER
        ========================= */

        .header {
            width: 100%;
            min-height: 37px;
            background: var(--green);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 4.3%;
            gap: 24px;
            position: relative;
            z-index: 20;
        }

        .brand {
            display: flex;
            align-items: center;
            flex-shrink: 0;
        }

        .brand-mark {
            width: 17px;
            height: 17px;
            border: 1px solid #f0f0e9;
            position: relative;
            margin-right: 5px;
        }

            .brand-mark::before {
                content: "";
                position: absolute;
                top: -1px;
                left: 5px;
                width: 1px;
                height: 17px;
                background: #f0f0e9;
            }

            .brand-mark::after {
                content: "";
                position: absolute;
                left: 0;
                right: 0;
                top: 5px;
                height: 1px;
                background: #f0f0e9;
            }

        .brand-copy {
            line-height: 1;
        }

        .brand-name {
            font-size: 9px;
            letter-spacing: 2px;
            font-weight: 400;
            white-space: nowrap;
        }

        .brand-subtitle {
            margin-top: 3px;
            font-size: 4.5px;
            letter-spacing: 1.15px;
            white-space: nowrap;
        }

        .brand-anniversary {
            border-left: 1px solid rgba(255,255,255,.5);
            margin-left: 5px;
            padding-left: 5px;
            color: var(--gold);
            font-size: 11px;
            white-space: nowrap;
        }

            .brand-anniversary small {
                display: block;
                text-align: center;
                font-size: 4px;
                margin-top: 2px;
            }

        /* CSS-ONLY MOBILE MENU */

        .menu-checkbox {
            position: absolute;
            width: 1px;
            height: 1px;
            opacity: 0;
            pointer-events: none;
        }

        .menu-toggle {
            display: none;
            color: white;
            font-size: 22px;
            cursor: pointer;
            line-height: 1;
        }

        /* NAVIGATION */

        .nav {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: clamp(14px, 2.6vw, 29px);
            min-height: 37px;
        }

            .nav a {
                position: relative;
                color: #e7e8e4;
                font-size: 5.5px;
                letter-spacing: .5px;
                text-transform: uppercase;
                white-space: nowrap;
            }

                .nav a:hover,
                .nav a.active {
                    color: #fff;
                }

                    .nav a.active::after {
                        content: "";
                        position: absolute;
                        height: 1px;
                        width: 3px;
                        background: #fff;
                        bottom: -7px;
                        left: 50%;
                    }

            .nav .contact-button {
                border: 1px solid rgba(255,255,255,.48);
                padding: 5px 9px;
            }

        /* =========================
           MAIN CONTENT
        ========================= */

        main {
            flex: 1;
            width: 100%;
            min-height: 148px;
            background: #fff;
        }

        /* =========================
           FOOTER
        ========================= */

        .footer {
            width: 100%;
            background: var(--footer);
            color: var(--text);
        }

        /* FIVE ALIGNED COLUMNS */

        .footer-main {
            width: 100%;
            min-height: 151px;
            display: grid;
            grid-template-columns: 1.35fr 0.8fr 1.05fr 1fr 1.5fr;
            align-items: start;
            gap: 20px;
            padding: 27px 4.3% 20px;
        }

        .footer-brand,
        .footer-column {
            min-width: 0;
            align-self: start;
        }

        /* COMPANY LOGO */

        .footer-brand {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }

        .footer-logo {
            display: flex;
            align-items: center;
            margin-bottom: 28px;
        }

            .footer-logo .brand-mark {
                border-color: #47534c;
                width: 21px;
                height: 21px;
                margin-right: 6px;
                flex-shrink: 0;
            }

                .footer-logo .brand-mark::before {
                    background: #47534c;
                    height: 21px;
                    left: 6px;
                }

                .footer-logo .brand-mark::after {
                    background: #47534c;
                    top: 6px;
                }

            .footer-logo .brand-name {
                font-size: 9px;
                letter-spacing: 2px;
                color: #333c36;
            }

            .footer-logo .brand-subtitle {
                font-size: 4.7px;
                letter-spacing: 1.15px;
                color: #414841;
            }

            .footer-logo .brand-anniversary {
                border-left-color: #c6b38e;
            }

        .member-label {
            font-size: 6px;
            margin-bottom: 4px;
            color: #444842;
        }

        .ecc-group {
            color: #171b18;
            font-weight: 900;
            font-size: 19px;
            letter-spacing: -1px;
            line-height: .9;
        }

            .ecc-group span {
                display: block;
                font-size: 5px;
                letter-spacing: 1.3px;
                font-weight: 400;
                margin-top: 3px;
            }

        /* COLUMN HEADINGS */

        .footer-column h3 {
            font-family: Georgia, "Times New Roman", serif;
            font-size: 10px;
            font-weight: 400;
            margin: 2px 0 12px;
            color: #252923;
            white-space: nowrap;
        }

        /* FOOTER LINKS */

        .footer-links {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 9px;
        }

            .footer-links a {
                font-size: 5.8px;
                color: #686b65;
                line-height: 1.4;
            }

                .footer-links a:hover {
                    color: #111;
                }

        /* SOCIAL LINKS */

        .social-links {
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .social-links a {
                width: 12px;
                height: 15px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #111;
                font-size: 13px;
                font-weight: 600;
                flex-shrink: 0;
            }

            .social-links svg {
                width: 12px;
                height: 12px;
                display: block;
            }

        /* CONTACT DETAILS */

        .contact-details {
            display: flex;
            flex-direction: column;
            gap: 9px;
        }

        .contact-line {
            display: flex;
            align-items: flex-start;
            gap: 6px;
            font-size: 5.8px;
            color: #666963;
            line-height: 1.5;
        }

            .contact-line svg {
                width: 9px;
                height: 9px;
                flex: 0 0 9px;
                stroke: #777c74;
                fill: none;
                stroke-width: 1.2;
            }

        .contact-bottom {
            display: flex;
            align-items: flex-start;
            flex-wrap: wrap;
            gap: 8px;
        }

        /* COPYRIGHT */

        .footer-bottom {
            min-height: 23px;
            border-top: 1px solid var(--line);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 7px 15px;
            text-align: center;
        }

            .footer-bottom p {
                font-size: 5.5px;
                color: #999a94;
            }

        /* =========================
           TABLET AND MOBILE
        ========================= */

        @@media (max-width: 767px) {
            .header

        {
            min-height: 60px;
            padding: 0 20px;
        }

        .menu-toggle {
            display: block;
        }

        .nav {
            display: none;
            position: absolute;
            top: 60px;
            left: 0;
            width: 100%;
            background: var(--green);
            padding: 22px;
            flex-direction: column;
            align-items: flex-start;
            gap: 22px;
            min-height: auto;
        }

        .menu-checkbox:checked ~ .header .nav {
            display: flex;
        }

        .menu-toggle::after {
            content: "";
        }

        .menu-checkbox:checked ~ .header .menu-toggle {
            font-size: 0;
        }

            .menu-checkbox:checked ~ .header .menu-toggle::after {
                content: "×";
                font-size: 27px;
            }

        .nav a {
            font-size: 11px;
        }

        .nav .contact-button {
            font-size: 10px;
            padding: 8px 14px;
        }

        main {
            min-height: 180px;
        }

        .footer-main {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 32px 24px;
            padding: 30px 24px;
        }

        .footer-column h3 {
            font-size: 13px;
            margin-bottom: 14px;
        }

        .footer-links {
            gap: 12px;
        }

            .footer-links a,
            .contact-line {
                font-size: 10px;
            }

        .social-links {
            gap: 12px;
        }

            .social-links a {
                width: 16px;
                height: 18px;
                font-size: 16px;
            }

            .social-links svg {
                width: 15px;
                height: 15px;
            }

        .member-label {
            font-size: 9px;
        }

        .ecc-group {
            font-size: 23px;
        }

            .ecc-group span {
                font-size: 6px;
            }

        .footer-bottom p {
            font-size: 9px;
        }

        }

        @@media (max-width: 420px) {
            .footer-main

        {
            grid-template-columns: 1fr 1fr;
            gap: 30px 16px;
            padding: 28px 18px;
        }

        .footer-logo .brand-name {
            font-size: 7px;
            letter-spacing: 1.2px;
        }

        .footer-logo .brand-anniversary {
            font-size: 9px;
        }

        .contact-bottom {
            flex-direction: column;
            gap: 9px;
        }

        }
    </style>
</head>

<body>

    <!-- CSS CHECKBOX -->
    <input type="checkbox" id="menuToggle" class="menu-checkbox">

    <!-- HEADER -->
    <header class="header">

        <a href="#home" class="brand" aria-label="ECC Fitout home">
            <span class="brand-mark"></span>
            <span class="brand-copy">
                <span class="brand-name">ECC FITOUT</span>
                <span class="brand-subtitle">&amp; CONSTRUCTION</span>
            </span>
            <span class="brand-anniversary">
                10
                <small>YEARS</small>
            </span>
        </a>

        <label for="menuToggle" class="menu-toggle"
               aria-label="Toggle navigation">☰</label>

        <nav class="nav" id="mainNav">
            <a href="#home" class="active">Home</a>
            <a href="#about">About Us</a>
            <a href="#services">Services</a>
            <a href="#projects">Projects⌄</a>
            <a href="#news">News</a>
            <a href="#life">Life at ECC Fitout</a>
            <a href="#contact" class="contact-button">Contact</a>
        </nav>

    </header>

    <!-- MAIN WHITE SPACE -->
    <main id="home">
        <div class="content"></div>
    </main>

    <!-- FOOTER -->
    <footer class="footer" id="contact">

        <div class="footer-main">

            <!-- COLUMN 1: BRAND -->
            <div class="footer-brand">

                <a href="#home" class="footer-logo">
                    <span class="brand-mark"></span>
                    <span class="brand-copy">
                        <span class="brand-name">ECC FITOUT</span>
                        <span class="brand-subtitle">&amp; CONSTRUCTION</span>
                    </span>
                    <span class="brand-anniversary">
                        10
                        <small>YEARS</small>
                    </span>
                </a>

                <p class="member-label">A Member Of</p>

                <div class="ecc-group">
                    ECC<span>GROUP</span>
                </div>

            </div>

            <!-- COLUMN 2: EXPLORE -->
            <div class="footer-column">
                <h3>Explore</h3>

                <div class="footer-links">
                    <a href="#projects">Projects</a>
                    <a href="#services">Services</a>
                    <a href="#about">About Us</a>
                </div>
            </div>

            <!-- COLUMN 3: ADDITIONAL LINKS -->
            <div class="footer-column">
                <h3 class="empty-heading">&nbsp;</h3>

                <div class="footer-links">
                    <a href="#life">Life at ECC Fitout</a>
                    <a href="#news">News &amp; Knowledge</a>
                    <a href="#contact">Contact</a>
                </div>
            </div>

            <!-- COLUMN 4: SOCIAL -->
            <div class="footer-column">
                <h3>Stay Connected</h3>

                <div class="social-links">

                    <a href="https://x.com/" target="_blank"
                       rel="noopener noreferrer" aria-label="X">
                        <svg viewBox="0 0 24 24" fill="currentColor">
                            <path d="M18.9 2H22l-6.8 7.8L23.2 22h-6.3L12 14.6 5.6 22H2.4l7.3-8.5L1.9 2h6.5l4.4 6.9L18.9 2Zm-1.1 18h1.7L7.3 3.9H5.5L17.8 20Z" />
                        </svg>
                    </a>

                    <a href="https://www.facebook.com/" target="_blank"
                       rel="noopener noreferrer" aria-label="Facebook">f</a>

                    <a href="https://www.linkedin.com/" target="_blank"
                       rel="noopener noreferrer" aria-label="LinkedIn">in</a>

                    <a href="https://www.instagram.com/" target="_blank"
                       rel="noopener noreferrer" aria-label="Instagram">
                        <svg viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2">
                            <rect x="3" y="3" width="18" height="18" rx="5" />
                            <circle cx="12" cy="12" r="4" />
                            <circle cx="17.5" cy="6.5" r="1"
                                    fill="currentColor" stroke="none" />
                        </svg>
