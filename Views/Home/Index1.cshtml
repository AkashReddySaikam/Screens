@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>Averra</title>

    <style>
        :root {
            --teal: #173d4a;
            --deep: #0c232b;
            --ink: #10252c;
            --paper: #fff;
            --mist: #b9cdd3;
            --line: rgba(255,255,255,.2);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
            scroll-padding-top: env(safe-area-inset-top, 0px);
        }

        body {
            font-family: "Jost", "Helvetica Neue", Arial, sans-serif;
            background: var(--paper);
            color: var(--ink);
        }

        a {
            color: inherit;
            text-decoration: none;
        }

            a:focus-visible,
            label:focus-visible {
                outline: 2px solid #7fd0e0;
                outline-offset: 4px;
            }

        /* =====================================================
                   CSS-ONLY MENU CHECKBOX
                ===================================================== */

        .menu-checkbox {
            position: absolute;
            width: 1px;
            height: 1px;
            overflow: hidden;
            clip-path: inset(50%);
            white-space: nowrap;
        }

        /* =====================================================
                   WHITE HEADER
                ===================================================== */

        .top-header {
            width: 100%;
            min-height: 88px;
            background: #fff;
            color: var(--ink);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 18px clamp(20px, 5vw, 64px);
            position: relative;
            z-index: 5;
        }

        /* LOGO */

        .logo {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            font-size: 12px;
            letter-spacing: .35em;
            font-weight: 500;
        }

            .logo svg {
                width: 30px;
                height: 26px;
            }

        /* =====================================================
                   HAMBURGER MENU
                ===================================================== */

        .burger {
            background: none;
            border: 0;
            padding: 10px;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 6px;
            width: 44px;
            height: 44px;
            color: var(--ink);
        }

            .burger i {
                display: block;
                width: 100%;
                height: 1px;
                background: currentColor;
                transition: transform .3s ease, width .3s ease;
            }

                .burger i:last-child {
                    width: 60%;
                    align-self: flex-end;
                }

        .header-burger:hover i:last-child {
            width: 100%;
        }

        /* =====================================================
                   HERO / NAVIGATION SECTION
                ===================================================== */

        .menu {
            width: 100%;
            position: relative;
            overflow: hidden;
            color: #fff;
            background: linear-gradient( 180deg, rgba(12,35,43,.82), rgba(12,35,43,.94) ), radial-gradient( ellipse at 20% 70%, #3a6a7a 0, transparent 50% ), linear-gradient( 115deg, #1d4a58 0 30%, #0f2d36 30% 55%, #274f5c 55% 100% );
            max-height: 760px;
            transition: max-height .45s ease;
        }

            .menu nav {
                min-height: min(760px, 100vh);
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: clamp(18px, 3.2vh, 30px);
                padding: 55px 20px;
                opacity: 1;
                visibility: visible;
                transition: opacity .25s ease, visibility .25s ease;
            }

                .menu nav a {
                    color: #fff;
                    font-size: clamp(13px, 1.6vw, 18px);
                    letter-spacing: .3em;
                    font-weight: 300;
                    padding: 4px 0;
                    border-bottom: 1px solid transparent;
                    transition: border-color .25s ease, color .25s ease;
                }

                    .menu nav a:hover {
                        border-color: #fff;
                        color: #d4e6eb;
                    }

        /* =====================================================
                   CSS-ONLY OPEN / CLOSE BEHAVIOUR

                   Unchecked = menu open
                   Checked   = menu closed
                ===================================================== */

        .menu-checkbox:checked ~ .menu {
            max-height: 0;
        }

            .menu-checkbox:checked ~ .menu nav {
                opacity: 0;
                visibility: hidden;
                pointer-events: none;
            }

        /* Toggle icon appearance */

        .menu-checkbox:checked ~ .top-header .header-burger i:first-child {
            transform: none;
        }

        .menu-checkbox:checked ~ .top-header .header-burger i:last-child {
            transform: none;
            width: 60%;
        }

        /* =====================================================
                   FOOTER
                ===================================================== */

        footer {
            width: 100%;
            background: var(--teal);
            color: #fff;
            padding: 56px 20px 36px;
            font-size: 14px;
            position: relative;
        }

        .fnav {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 10px 28px;
            font-weight: 300;
        }

            .fnav a:hover {
                text-decoration: underline;
                text-underline-offset: 5px;
            }

        footer h3 {
            margin: 44px 0 16px;
            text-align: center;
            font-weight: 400;
            font-size: 13px;
            letter-spacing: .2em;
        }

        /* CONTACT DETAILS */

        .contact {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 12px 32px;
            color: var(--mist);
            font-weight: 300;
        }

            .contact span {
                display: flex;
                align-items: center;
                gap: 8px;
            }

        /* SOCIAL LINKS */

        .social {
            display: flex;
            justify-content: center;
            gap: 12px;
        }

            .social a {
                width: 34px;
                height: 34px;
                border: 1px solid var(--line);
                border-radius: 50%;
                display: grid;
                place-items: center;
                font-size: 12px;
                transition: background .25s ease;
            }

                .social a:hover {
                    background: rgba(255,255,255,.15);
                }

        /* FOOTER BOTTOM */

        .base {
            margin-top: 48px;
            display: flex;
            flex-wrap: wrap;
            align-items: flex-end;
            justify-content: space-between;
            gap: 20px;
            max-width: 1100px;
            margin-left: auto;
            margin-right: auto;
        }

            .base small {
                color: var(--mist);
                font-weight: 300;
                width: 100%;
                order: 3;
                text-align: center;
            }

        .gcc {
            font-weight: 600;
            font-size: 24px;
            letter-spacing: .05em;
        }

            .gcc em {
                display: block;
                font-style: normal;
                font-size: 8px;
                letter-spacing: .2em;
                font-weight: 300;
                color: var(--mist);
            }

        /* =====================================================
                   RESPONSIVE
                ===================================================== */

        @@media (max-width: 600px) {
            .top-header {
                min-height: 75px;
                padding: 15px 20px;
            }

            .menu nav {
                min-height: 650px;
                gap: 20px;
            }

                .menu nav a {
                    font-size: 13px;
                }

            footer {
                padding: 40px 18px 25px;
            }

            .fnav {
                gap: 12px 18px;
            }

            .contact {
                flex-direction: column;
                align-items: center;
            }

            .base {
                align-items: center;
            }

            .gcc {
                font-size: 20px;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                transition: none !important;
                scroll-behavior: auto !important;
            }
        }
    </style>
</head>

<body>

    <!-- =====================================================
         WHITE HEADER WITH LOGO AND MENU
    ====================================================== -->
    <!-- Menu is open by default. Checking this box closes it. -->
    <input type="checkbox"
           id="menuToggle"
           class="menu-checkbox">

    <header class="top-header">

        <a class="logo" href="#" aria-label="Averra home">
            <svg viewBox="0 0 30 26"
                 fill="none"
                 stroke="#173d4a"
                 stroke-width="1.6">
                <path d="M2 25 15 2l13 23M9 25l6-10 6 10" />
            </svg>
            AVERRA
        </a>

        <label for="menuToggle"
               class="burger header-burger"
               aria-label="Toggle navigation menu"
               title="Toggle menu">

            <i></i>
            <i></i>

        </label>

    </header>


    <!-- =====================================================
         HERO MENU
    ====================================================== -->

    <section class="menu" id="menu">

        <nav aria-label="Main navigation">
            <a href="#">HOME</a>
            <a href="#">ABOUT</a>
            <a href="#">SERVICES</a>
            <a href="#">PROJECTS</a>
            <a href="#">BLOG</a>
            <a href="#">SUSTAINABILITY</a>
            <a href="#">CONTACT</a>
        </nav>

    </section>


    <!-- =====================================================
         FOOTER
    ====================================================== -->

    <footer>

        <nav class="fnav" aria-label="Footer navigation">
            <a href="#">Home</a>
            <a href="#">About</a>
            <a href="#">Projects</a>
            <a href="#">Sustainability</a>
            <a href="#">Contact</a>
        </nav>

        <h3>CONTACT</h3>

        <div class="contact">
            <span>&#9742; +00 123 456 789</span>
            <span>&#9993; hello@averra.com</span>
            <span>&#9906; 12 Harbour Road, City</span>
        </div>

        <h3>SOCIAL LINKS</h3>

        <div class="social">
            <a href="#" aria-label="Facebook">f</a>
            <a href="#" aria-label="Instagram">in</a>
            <a href="#" aria-label="LinkedIn">li</a>
            <a href="#" aria-label="X">x</a>
        </div>

        <div class="base">

            <a class="logo" href="#" aria-label="Averra home">
                <svg viewBox="0 0 30 26"
                     fill="none"
                     stroke="#fff"
                     stroke-width="1.6">
                    <path d="M2 25 15 2l13 23M9 25l6-10 6 10" />
                </svg>
                AVERRA
            </a>

            <div class="gcc">
                <em>Partner of</em>
                GCC
            </div>

            <small>&copy; 2026 Averra. All rights reserved.</small>

        </div>

    </footer>

</body>
</html>
